# tartarus-claude@.service — claude agents for the named user.

[Unit]
Description=Tartarus Claude agents session for %i
After=tartarus-bootstrap.service
Wants=tartarus-bootstrap.service

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/tartarus-claude.sh
Restart=no

[Install]
WantedBy=multi-user.target
